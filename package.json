{
  "name": "fennel-games",
  "version": "0.1.0",
  "description": "Fennel Games — a hub of offline-first daily word puzzles (PWA + Capacitor iOS/Android)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4180",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -b --noEmit",
    "gen:data": "tsx tools/build-all-datasets.ts",
    "gen:data:edit-clusters": "tsx tools/build-edit-clusters.ts",
    "gen:data:odd-one-gradient": "tsx tools/build-odd-one-gradient.ts",
    "gen:data:twin-trails": "tsx tools/build-twin-trails.ts",
    "gen:data:tier-list": "tsx tools/build-tier-list.ts",
    "gen:data:web-hub": "tsx tools/build-web-hub.ts",
    "gen:data:edit-ladder-trails": "tsx tools/build-edit-ladder-trails.ts",
    "gen:data:semantic-gradient": "tsx tools/build-semantic-gradient.ts",
    "gen:data:semantic-constellation": "tsx tools/build-semantic-constellation.ts",
    "gen:data:mirrorle": "tsx tools/build-mirrorle.ts",
    "gen:data:parallax": "tsx tools/build-parallax.ts",
    "gen:data:seam": "tsx tools/build-seam.ts",
    "gen:data:isthmus": "tsx tools/build-isthmus.ts",
    "gen:data:driftword": "tsx tools/build-driftword.ts",
    "gen:data:isobar": "tsx tools/build-isobar.ts",
    "gen:data:tollgate": "tsx tools/build-tollgate.ts",
    "gen:data:ghost-group": "tsx tools/build-ghost-group.ts",
    "gen:data:fork": "tsx tools/build-fork.ts",
    "gen:data:ration": "tsx tools/build-ration.ts",
    "gen:data:overdraft": "tsx tools/build-overdraft.ts",
    "gen:data:clueback": "tsx tools/build-clueback.ts",
    "gen:data:fault-lines": "tsx tools/build-fault-lines.ts",
    "gen:data:undertow": "tsx tools/build-undertow.ts",
    "gen:data:fogline": "tsx tools/build-fogline.ts",
    "gen:data:tare": "tsx tools/build-tare.ts",
    "gen:data:marginalia": "tsx tools/build-marginalia.ts",
    "gen:data:cipher-diary": "tsx tools/build-cipher-diary.ts",
    "gen:data:decay": "tsx tools/build-decay.ts",
    "gen:data:cascade-type": "tsx tools/build-cascade-type.ts",
    "gen:lowball": "tsx tools/build-lowball.ts",
    "gen:lowball-countries": "tsx tools/build-lowball-countries.ts",
    "e2e": "playwright test",
    "cap:sync": "cap sync",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/preferences": "^6.0.2",
    "@capacitor/share": "^6.0.2",
    "@carbon/styles": "^1.111.0",
    "@carbon/web-components": "^2.59.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@playwright/test": "^1.47.0",
    "@vitest/coverage-v8": "^2.1.1",
    "jsdom": "^25.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.6",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.1"
  }
}
